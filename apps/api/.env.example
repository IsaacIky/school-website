# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/school_db?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ── API ───────────────────────────────────────────────────────────────────────
PORT=4000
WEB_URL="http://localhost:3000"

# ── Email (student OTP codes) ─────────────────────────────────────────────────
# Leave SMTP_HOST empty in development to print emails to the API log instead.
# Required when NODE_ENV=production.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="no-reply@university.ac.zw"
