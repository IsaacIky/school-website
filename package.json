{
  "name": "school-website",
  "private": true,
  "version": "0.0.1",
  "description": "DB-configurable multi-campus university platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter @school/web dev\" \"pnpm --filter @school/api start:dev\"",
    "build": "pnpm --filter @school/db build && pnpm --filter @school/api build && pnpm --filter @school/web build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "db:generate": "pnpm --filter @school/db db:generate",
    "db:migrate": "pnpm --filter @school/db db:migrate",
    "db:migrate:dev": "pnpm --filter @school/db db:migrate:dev",
    "db:seed": "pnpm --filter @school/db db:seed",
    "db:studio": "pnpm --filter @school/db db:studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
